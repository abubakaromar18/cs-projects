{
  "name": "logic-gate-simulator",
  "version": "1.0.0",
  "description": "Drag-and-drop digital logic simulator in TypeScript: gates, wires, adders, latches and truth tables",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && npx --yes serve@14 -l 5173 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
