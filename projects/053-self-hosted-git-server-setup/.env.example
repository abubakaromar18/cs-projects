# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit real passwords.

COMPOSE_PROJECT_NAME=gitea
GITEA_VERSION=1.22
POSTGRES_VERSION=16

# Database credentials (generate one with: openssl rand -base64 24)
POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gitea

# Networking. Keep GITEA_BIND=127.0.0.1 unless a reverse proxy/firewall is in front.
GITEA_BIND=127.0.0.1
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/

# Gitea policy
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_LOG_LEVEL=Info

# Backups
BACKUP_DIR=./backups
BACKUP_KEEP=7
