# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "lib" << "test"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end

desc "Build the example site into _site/"
task :build do
  ruby "bin/blog build"
end

desc "Build and serve the example site on http://127.0.0.1:4000/"
task :serve do
  ruby "bin/blog serve"
end

task default: :test
