{
  "rules": [
    {
      "intent": "math",
      "priority": 10,
      "pattern": "^(?:what is|what's|calculate|compute|solve)?\\s*(?P<expr>[-+]?[\\d.]+(?:\\s*(?:[-+*/%^x×÷]|\\*\\*|//)\\s*[-+]?[\\d.(]+[\\d.)]*)+)\\s*\\??$"
    },
    {
      "intent": "set_name",
      "priority": 9,
      "pattern": "\\b(?:my name is|call me|i am called)\\s+(?P<name>[A-Za-z][A-Za-z'-]{0,30})"
    },
    {
      "intent": "ask_my_name",
      "priority": 8,
      "pattern": "\\b(?:what(?:'s| is) my name|do you (?:know|remember) my name|who am i)\\b"
    },
    {
      "intent": "time",
      "priority": 5,
      "pattern": "\\bwhat(?:'s| is)? the time\\b|\\bwhat time is it\\b"
    },
    {
      "intent": "goodbye",
      "priority": 5,
      "pattern": "^\\s*(?:bye|goodbye|quit|exit|see ya|cya)\\s*[.!]*\\s*$"
    }
  ],
