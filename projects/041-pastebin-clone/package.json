{
  "name": "pastebin-clone",
  "version": "1.0.0",
  "description": "A small Express pastebin with expiring pastes, burn-after-read, and server-side syntax highlighting.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "highlight.js": "^11.10.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
