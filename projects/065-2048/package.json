{
  "name": "game-2048",
  "version": "1.0.0",
  "description": "2048 sliding-tile puzzle in TypeScript with keyboard + swipe controls, CSS animations, undo and best-score tracking",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build --silent && npx --yes serve@14 -l 5173 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
