# First 20 Fibonacci numbers, kept as a pair (a b) on the stack.
0 1                 # a b
20~n n              # loop counter
[ $
  ^ . 32,           # print a (over, then print) and a space
  : @ +             # a b -> b a+b
  n 1 - : ~n        # n = n - 1, leave it as the loop condition
] $ $ $ 10,
