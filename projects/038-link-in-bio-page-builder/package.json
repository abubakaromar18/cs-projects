{
  "name": "link-in-bio-page-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Create a shareable link-in-bio profile page with SvelteKit.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "test": "vitest run",
    "test:e2e": "ORIGIN=http://127.0.0.1:4173 vite build && node --test e2e/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
